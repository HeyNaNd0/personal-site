---
import Base from "../layouts/Base.astro";
import { SITE } from "../data/site";
---

<Base title={`Page not found — ${SITE.name}`} description="This page doesn't exist." noindex>
  <section class="notfound">
    <p class="eyebrow">404</p>
    <h1 class="notfound__title">This page doesn't exist.</h1>
    <p class="notfound__text">The link may be old, or the page may have moved.</p>
    <a class="btn btn--solid" href="/">Back to home</a>
  </section>
</Base>

<style>
  .notfound {
    min-height: 80vh;
    min-height: 80svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: calc(var(--header-h) + 48px) var(--gutter) 64px;
    text-align: center;
  }

  .notfound__title {
    font-family: var(--font-serif);
    font-size: clamp(32px, 6vw, 48px);
    font-weight: 400;
    letter-spacing: -1px;
  }

  .notfound__text {
    color: var(--ink-muted);
    margin-bottom: 24px;
  }
</style>
