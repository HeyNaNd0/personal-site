---
import Base from "../layouts/Base.astro";
import Prompt from "../components/Prompt.astro";
import { SITE } from "../data/site";
---

<Base title={`Page not found — ${SITE.name}`} description="This page doesn't exist." noindex>
  <section class="block">
    <Prompt as="p" command="cat this-page" />
    <div class="out">
      <h1 class="nf__title">cat: this-page: No such file or directory</h1>
      <p class="comment"># The link may be old, or the page may have moved.</p>
      <p class="nf__actions"><a class="tbtn tbtn--primary" href="/">cd ~</a></p>
    </div>
  </section>
</Base>

<style>
  .nf__title {
    font-size: inherit;
    font-weight: 500;
    color: var(--amber);
  }

  .nf__actions {
    margin-top: 24px;
  }
</style>
