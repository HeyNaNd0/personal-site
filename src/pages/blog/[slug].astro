---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Prompt from "../../components/Prompt.astro";
import { SITE } from "../../data/site";
import { getPublishedPosts, isLocal, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = (await getPublishedPosts()).filter(isLocal);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags } = post.data;
const url = new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = new URL("/", Astro.site).href;
const isoDate = (d: Date) => d.toISOString().slice(0, 10);

const article = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  url,
  mainEntityOfPage: url,
  datePublished: date?.toISOString(),
  dateModified: (updated ?? date)?.toISOString(),
  keywords: tags.join(", "),
  image: new URL(SITE.ogImage, Astro.site).href,
  author: { "@type": "Person", "@id": `${siteUrl}#person`, name: SITE.name, url: siteUrl },
};
---

<Base
  title={`${title} — ${SITE.name}`}
  description={description}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
  jsonLd={[article]}
>
  <article class="block">
    <Prompt as="p" command={`cat posts/${post.id}.md`} />
    <header class="out article__header">
      <h1 class="article__title">{title}</h1>
      <p class="dim article__meta">
        {date && <time datetime={isoDate(date)}>{isoDate(date)}</time>}
        {tags.map((t) => <span class="ok">{t.toLowerCase()}</span>)}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="article__back"><a class="tbtn" href="/#blog">cd ..</a></p>
  </article>
</Base>

<style>
  .article__header {
    margin-bottom: 32px;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2ch;
  }

  .article__title {
    font-size: clamp(24px, 4.4vw, 36px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--strong);
    margin-bottom: 8px;
    max-width: 40ch;
  }

  .article__back {
    margin-top: 48px;
  }

  .prose {
    max-width: 72ch;
  }

  .prose > :global(*) + :global(*) {
    margin-top: 1.1em;
  }

  .prose :global(h2) {
    font-size: 19px;
    font-weight: 600;
    color: var(--strong);
    margin-top: 2em;
  }

  .prose :global(h2)::before {
    content: "## ";
    color: var(--green);
  }

  .prose :global(h3) {
    font-size: inherit;
    font-weight: 600;
    color: var(--strong);
    margin-top: 1.6em;
  }

  .prose :global(h3)::before {
    content: "### ";
    color: var(--green);
  }

  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(strong) {
    color: var(--strong);
    font-weight: 600;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 2ch;
  }

  .prose :global(ul) {
    list-style: "- ";
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(li + li) {
    margin-top: 0.4em;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--green);
    padding-left: 2ch;
    color: var(--muted);
  }

  .prose :global(code) {
    color: var(--amber);
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 14px 16px;
    background: var(--bar);
    border: 1px solid var(--line);
    border-radius: 4px;
    line-height: 1.6;
  }

  .prose :global(pre code) {
    color: var(--fg);
  }

  .prose :global(img) {
    max-width: 100%;
    border: 1px solid var(--line);
  }

  /* Prism token colors (class-based, so they work under the strict CSP) */
  .prose :global(.token.comment),
  .prose :global(.token.prolog),
  .prose :global(.token.doctype),
  .prose :global(.token.cdata) {
    color: var(--muted);
    font-style: italic;
  }

  .prose :global(.token.punctuation),
  .prose :global(.token.operator) {
    color: #b9c2bb;
  }

  .prose :global(.token.keyword),
  .prose :global(.token.atrule),
  .prose :global(.token.important),
  .prose :global(.token.selector) {
    color: var(--amber);
  }

  .prose :global(.token.string),
  .prose :global(.token.char),
  .prose :global(.token.attr-value),
  .prose :global(.token.url) {
    color: var(--green);
  }

  .prose :global(.token.function),
  .prose :global(.token.class-name),
  .prose :global(.token.builtin) {
    color: var(--blue);
  }

  .prose :global(.token.number),
  .prose :global(.token.boolean),
  .prose :global(.token.constant),
  .prose :global(.token.symbol),
  .prose :global(.token.property),
  .prose :global(.token.key),
  .prose :global(.token.attr-name),
  .prose :global(.token.tag) {
    color: #f0a3a3;
  }

  .prose :global(.token.variable),
  .prose :global(.token.parameter),
  .prose :global(.token.regex) {
    color: #d7b8f3;
  }
</style>
