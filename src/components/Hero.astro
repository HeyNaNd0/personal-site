---
import { HERO, SITE } from "../data/site";
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="hero__glow hero__glow--a" aria-hidden="true"></div>
  <div class="hero__glow hero__glow--b" aria-hidden="true"></div>
  <div class="hero__content intro">
    <p class="eyebrow hero__eyebrow">{HERO.eyebrow}</p>
    <h1 id="hero-title" class="hero__title">{SITE.name}</h1>
    <p class="hero__lede">{HERO.lede}</p>
    <div class="hero__actions">
      <a class="btn btn--solid" href="#experience">View Experience</a>
      <a class="btn btn--ghost" href="#contact">Get in Touch</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--header-h) + 32px) var(--gutter) 64px;
    background: linear-gradient(165deg, #fcfcfa 0%, #f5f3ef 50%, #eae7e0 100%);
  }

  .hero__glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .hero__glow--a {
    top: 10%;
    right: 5%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgb(107 143 113 / 0.08) 0%, transparent 70%);
  }

  .hero__glow--b {
    bottom: 15%;
    left: 8%;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgb(107 143 113 / 0.05) 0%, transparent 70%);
  }

  .hero__content {
    position: relative;
    max-width: 800px;
    text-align: center;
  }

  .hero__eyebrow {
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 16px;
  }

  .hero__title {
    font-family: var(--font-serif);
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -1.5px;
    color: var(--ink);
    margin-bottom: 24px;
  }

  .hero__lede {
    font-size: 18px;
    line-height: 1.7;
    color: var(--ink-muted);
    max-width: 580px;
    margin: 0 auto 40px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }

  @media (max-width: 480px) {
    .hero__lede {
      font-size: 17px;
    }
    .hero__actions .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
