---
import { PROJECTS } from "../data/site";
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow">Projects</p>
      <h2 id="projects-title" class="section-title">What I'm building</h2>
    </div>
    <ul class="projects">
      {
        PROJECTS.map((p) => (
          <li class="project reveal">
            <div class="project__head">
              <h3 class="project__title">
                <a href={p.link} target="_blank" rel="noopener">
                  {p.title}
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </h3>
              <span class="project__arrow" aria-hidden="true">↗</span>
            </div>
            <p class="project__desc">{p.description}</p>
            <ul class="chips" aria-label="Technologies">
              {p.tags.map((t) => (
                <li class="chip">{t}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .projects {
    display: grid;
    gap: 24px;
  }

  .project {
    position: relative;
    padding: 32px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .project:hover,
  .project:focus-within {
    border-color: var(--accent);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.06);
  }

  @media (prefers-reduced-motion: no-preference) {
    .project:hover {
      transform: translateY(-2px);
    }
  }

  .project__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 12px;
  }

  .project__title {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--ink);
  }

  .project__title a {
    text-decoration: none;
  }

  /* Whole card is clickable via the title link */
  .project__title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 8px;
  }

  .project__title a:focus-visible {
    outline: none;
  }

  .project:has(a:focus-visible) {
    outline: 2px solid var(--accent-ink);
    outline-offset: 3px;
  }

  .project__arrow {
    color: var(--accent);
  }

  .project__desc {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-muted);
    margin-bottom: 16px;
  }

  @media (max-width: 559px) {
    .project {
      padding: 24px;
    }
  }
</style>
