---
import Prompt from "./Prompt.astro";
import { PROJECTS } from "../data/site";

const toIdent = (s: string) => s.toLowerCase().replace(/\s+/g, "-");
---

<section id="projects" class="block" aria-labelledby="proj-cmd">
  <Prompt id="proj-cmd" command="ls -l projects/" />
  <div class="out">
    <p class="dim">total {PROJECTS.length}</p>
    <ul class="ls">
      {
        PROJECTS.map((p) => (
          <li class="ls__item">
            <div class="ls__line">
              <span class="ls__perm dim hide-sm" aria-hidden="true">drwxr-xr-x eric</span>
              <h3 class="ls__name">
                <a href={p.link} target="_blank" rel="noopener">
                  {p.dir}/<span class="sr-only"> {p.title} (opens in a new tab)</span>
                </a>
              </h3>
            </div>
            <p class="ls__desc">{p.description}</p>
            <ul class="ls__tags" aria-label="Technologies">
              {p.tags.map((t) => (
                <li>{toIdent(t)}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ls__item {
    margin-top: 20px;
  }

  .ls__line {
    display: flex;
    gap: 2ch;
    align-items: baseline;
  }

  .ls__perm {
    flex: none;
    white-space: nowrap;
  }

  .ls__name {
    font-size: inherit;
    font-weight: 600;
  }

  .ls__desc,
  .ls__tags {
    padding-left: 17ch;
    max-width: calc(72ch + 17ch);
  }

  .ls__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2ch;
    margin-top: 4px;
    color: var(--green);
  }

  .ls__tags::before {
    content: "#";
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .ls__desc,
    .ls__tags {
      padding-left: 2ch;
    }
  }
</style>
