---
import Prompt from "./Prompt.astro";
import { ABOUT, SKILLS } from "../data/site";

const toIdent = (s: string) => s.toLowerCase().replace(/\s+/g, "-");
---

<section id="about" class="block" aria-labelledby="about-cmd">
  <Prompt id="about-cmd" command="cat about.md" />
  <div class="out prose-out">
    {ABOUT.columns.flat().map((p) => <p>{p}</p>)}
  </div>

  <Prompt as="p" class="about__stack-cmd" command="cat stack.txt" />
  <ul class="out stack" aria-label="Skills">
    {SKILLS.map((s) => <li>{toIdent(s)}</li>)}
  </ul>
</section>

<style>
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 3ch;
    max-width: 72ch;
    color: var(--green);
  }
</style>
