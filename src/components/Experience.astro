---
import Prompt from "./Prompt.astro";
import { EXPERIENCE } from "../data/site";

const toIdent = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
---

<section id="experience" class="block" aria-labelledby="exp-cmd">
  <Prompt id="exp-cmd" command="kubectl get experience" />
  <div class="out kube">
    <div class="kube__row kube__head" aria-hidden="true">
      <span>NAME</span><span>ROLE</span><span>AGE</span><span class="hide-sm">LOCATION</span><span></span>
    </div>
    {
      EXPERIENCE.map((job, i) => (
        <details class="kube__item" name="experience" open={i === 0}>
          <summary class="kube__row">
            <h3 class="kube__name">{job.kube.name}</h3>
            <span class="kube__role">{job.kube.role}</span>
            <span class={i === 0 ? "ok" : undefined}>{job.kube.age}</span>
            <span class="hide-sm dim kube__loc">{toIdent(job.location)}</span>
            <span class="kube__toggle" aria-hidden="true" />
          </summary>
          <div class="describe">
            <dl class="describe__meta">
              <dt>Company:</dt>
              <dd>{job.company}</dd>
              <dt>Role:</dt>
              <dd>{job.title}</dd>
              <dt>Period:</dt>
              <dd>{job.period}</dd>
              <dt>Location:</dt>
              <dd>{job.location}</dd>
            </dl>
            <p class="describe__label">Highlights:</p>
            <ul class="describe__list">
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
        </details>
      ))
    }
  </div>
  <p class="out comment"># Select a row to describe it.</p>
</section>

<style>
  .kube {
    border-top: 1px solid transparent;
  }

  .kube__row {
    display: grid;
    grid-template-columns: 11ch 21ch 10ch minmax(0, 1fr) 3ch;
    column-gap: 2ch;
    align-items: baseline;
    padding: 2px 6px;
    margin: 0 -6px;
  }

  .kube__head {
    color: var(--muted);
  }

  .kube__item > summary {
    cursor: pointer;
    list-style: none;
    border-radius: 3px;
  }

  .kube__item > summary::-webkit-details-marker {
    display: none;
  }

  .kube__item > summary:hover {
    background: var(--hover);
  }

  .kube__item[open] > summary {
    background: var(--hover);
  }

  .kube__name {
    font-size: inherit;
    font-weight: 600;
    color: var(--strong);
  }

  .kube__loc {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .kube__toggle::after {
    content: "[+]";
    color: var(--muted);
  }

  .kube__item[open] .kube__toggle::after {
    content: "[-]";
    color: var(--green);
  }

  .describe {
    margin: 10px 0 18px;
    padding-left: 2ch;
    border-left: 1px solid var(--line-strong);
    max-width: 78ch;
  }

  .describe__meta {
    display: grid;
    grid-template-columns: 10ch minmax(0, 1fr);
    column-gap: 1ch;
  }

  .describe__meta dt,
  .describe__label {
    color: var(--muted);
  }

  .describe__meta dd {
    color: var(--strong);
  }

  .describe__label {
    margin-top: 8px;
  }

  .describe__list li {
    position: relative;
    padding-left: 2ch;
    margin-top: 4px;
  }

  .describe__list li::before {
    content: "-";
    position: absolute;
    left: 0;
    color: var(--green);
  }

  /* Smooth open/close where the browser supports animating to height:auto */
  @supports (interpolate-size: allow-keywords) {
    .kube__item {
      interpolate-size: allow-keywords;
    }
    @media (prefers-reduced-motion: no-preference) {
      .kube__item::details-content {
        block-size: 0;
        overflow: hidden;
        transition:
          block-size 0.3s ease,
          content-visibility 0.3s allow-discrete;
      }
      .kube__item[open]::details-content {
        block-size: auto;
      }
    }
  }

  @media (max-width: 560px) {
    .kube__row {
      grid-template-columns: 9ch minmax(0, 1fr) 8ch 3ch;
      column-gap: 1ch;
    }
    .kube__role {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .describe {
      padding-left: 1.5ch;
    }
    .describe__meta {
      grid-template-columns: 1fr;
    }
    .describe__meta dd {
      margin-bottom: 2px;
    }
  }
</style>
