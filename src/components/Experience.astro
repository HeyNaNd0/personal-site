---
import { EXPERIENCE } from "../data/site";
---

<section id="experience" class="section section--alt" aria-labelledby="experience-title">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow">Experience</p>
      <h2 id="experience-title" class="section-title">Where I've worked</h2>
    </div>
    <div class="jobs">
      {
        EXPERIENCE.map((job, i) => (
          <details class="job reveal" name="experience" open={i === 0}>
            <summary class="job__summary">
              <h3 class="job__company">{job.company}</h3>
              <span class="job__title">{job.title}</span>
              <span class="job__period">{job.period}</span>
              <span class="job__location">{job.location}</span>
              <span class="job__chevron" aria-hidden="true">›</span>
            </summary>
            <ul class="job__bullets">
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .jobs {
    border-bottom: 1px solid var(--line-strong);
  }

  .job {
    border-top: 1px solid var(--line-strong);
  }

  .job__summary {
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas:
      "company period   chevron"
      "title   location chevron";
    column-gap: 16px;
    row-gap: 2px;
    align-items: baseline;
    padding: 28px 0;
    cursor: pointer;
    list-style: none;
  }

  .job__summary::-webkit-details-marker {
    display: none;
  }

  .job__company {
    grid-area: company;
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--ink);
    transition: color 0.2s;
  }

  .job__summary:hover .job__company {
    color: var(--accent-ink);
  }

  .job__title {
    grid-area: title;
    font-size: 15px;
    color: var(--ink-muted);
  }

  .job__period {
    grid-area: period;
    justify-self: end;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-faint);
  }

  .job__location {
    grid-area: location;
    justify-self: end;
    font-size: 13px;
    color: var(--ink-faint);
  }

  .job__chevron {
    grid-area: chevron;
    align-self: center;
    font-size: 18px;
    color: var(--accent);
    transition: transform 0.3s ease;
  }

  .job[open] .job__chevron {
    transform: rotate(90deg);
  }

  .job__bullets {
    padding: 0 0 28px 20px;
  }

  .job__bullets li {
    position: relative;
    padding-left: 16px;
    margin-bottom: 10px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-chip);
  }

  .job__bullets li::before {
    content: "›";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  /* Smooth open/close where the browser supports animating to height:auto */
  @supports (interpolate-size: allow-keywords) {
    .job {
      interpolate-size: allow-keywords;
    }
    @media (prefers-reduced-motion: no-preference) {
      .job::details-content {
        block-size: 0;
        overflow: hidden;
        transition:
          block-size 0.4s ease,
          content-visibility 0.4s allow-discrete;
      }
      .job[open]::details-content {
        block-size: auto;
      }
    }
  }

  @media (max-width: 559px) {
    .job__summary {
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        "company  company  chevron"
        "title    title    chevron"
        "period   location location";
      column-gap: 12px;
      row-gap: 4px;
      padding: 22px 0;
    }
    .job__period,
    .job__location {
      justify-self: start;
      margin-top: 4px;
    }
    .job__bullets {
      padding-left: 0;
    }
  }
</style>
