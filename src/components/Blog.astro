---
import { getPublishedPosts, postHref, formatDate, isExternal } from "../lib/posts";

const posts = await getPublishedPosts();
---

<section id="blog" class="section section--alt" aria-labelledby="blog-title">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow">Blog</p>
      <h2 id="blog-title" class="section-title">Writing &amp; notes</h2>
    </div>
    <ul class="posts">
      {
        posts.map((post) => {
          const href = postHref(post);
          const external = isExternal(post);
          return (
            <li class="post reveal">
              <div class="post__head">
                <h3 class="post__title">
                  {href ? (
                    <a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined}>
                      {post.data.title}
                      {external && <span class="sr-only"> (opens in a new tab)</span>}
                    </a>
                  ) : (
                    post.data.title
                  )}
                </h3>
                {post.data.date && (
                  <time class="post__date" datetime={post.data.date.toISOString().slice(0, 10)}>
                    {formatDate(post.data.date)}
                  </time>
                )}
              </div>
              <p class="post__excerpt">{post.data.description}</p>
              <div class="post__foot">
                <ul class="chips" aria-label="Tags">
                  {post.data.tags.map((t) => (
                    <li class="chip chip--alt">{t}</li>
                  ))}
                </ul>
                {href ? (
                  <span class="post__cta" aria-hidden="true">
                    Read {external ? "↗" : "→"}
                  </span>
                ) : (
                  <span class="post__soon">Coming soon</span>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .posts {
    border-bottom: 1px solid var(--line-strong);
  }

  .post {
    position: relative;
    padding: 32px 0;
    border-top: 1px solid var(--line-strong);
  }

  .post__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 8px;
  }

  .post__title {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.35;
    color: var(--ink);
    max-width: 80%;
  }

  .post__title a {
    text-decoration: none;
  }

  .post__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .post:has(a:hover) .post__title,
  .post:has(a:hover) .post__cta {
    color: var(--accent-ink);
  }

  .post__title a:focus-visible {
    outline: none;
  }

  .post:has(a:focus-visible) {
    outline: 2px solid var(--accent-ink);
    outline-offset: 4px;
  }

  .post__date {
    flex: none;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-faint);
  }

  .post__excerpt {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-muted);
    margin-bottom: 12px;
  }

  .post__foot {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .chip--alt {
    background: var(--bg-chip-alt);
  }

  .post__cta,
  .post__soon {
    margin-left: auto;
    flex: none;
    font-size: 13px;
  }

  .post__cta {
    font-weight: 500;
    color: var(--accent-ink);
  }

  .post__soon {
    color: var(--ink-faint);
    font-style: italic;
  }

  @media (max-width: 559px) {
    .post__head {
      flex-direction: column;
      gap: 4px;
    }
    .post__title {
      max-width: none;
    }
    .post__foot {
      flex-wrap: wrap;
    }
  }
</style>
