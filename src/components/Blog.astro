---
import Prompt from "./Prompt.astro";
import { getPublishedPosts, postHref, isExternal } from "../lib/posts";

const posts = await getPublishedPosts();
const isoDate = (d: Date) => d.toISOString().slice(0, 10);
const hostOf = (url: string) => new URL(url).hostname.replace(/^www\./, "");
---

<section id="blog" class="block" aria-labelledby="blog-cmd">
  <Prompt id="blog-cmd" command="ls -t posts/" />
  <ul class="out posts">
    {
      posts.map((post) => {
        const href = postHref(post);
        const external = isExternal(post);
        return (
          <li class="post">
            {post.data.date ? (
              <time class="post__date dim" datetime={isoDate(post.data.date)}>
                {isoDate(post.data.date)}
              </time>
            ) : (
              <span class="post__date warn">drafting</span>
            )}
            <div class="post__body">
              <h3 class="post__title">
                {href ? (
                  <a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined}>
                    {post.data.title}
                    {external && <span class="sr-only"> (opens in a new tab)</span>}
                  </a>
                ) : (
                  post.data.title
                )}
              </h3>
              <p class="post__desc">{post.data.description}</p>
              {external && post.data.external && <p class="dim">on {hostOf(post.data.external)}</p>}
              {post.data.upcoming && <p class="warn">coming soon</p>}
            </div>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .post {
    display: grid;
    grid-template-columns: 10ch minmax(0, 1fr);
    column-gap: 3ch;
    max-width: calc(72ch + 13ch);
  }

  .post + .post {
    margin-top: 18px;
  }

  .post__title {
    font-size: inherit;
    font-weight: 600;
    color: var(--strong);
  }

  @media (max-width: 560px) {
    .post {
      grid-template-columns: 1fr;
    }
  }
</style>
