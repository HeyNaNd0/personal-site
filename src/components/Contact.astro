---
import Prompt from "./Prompt.astro";
import { CONTACT, LINKS } from "../data/site";

const display = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "");
const items = [
  { key: "email", href: `mailto:${LINKS.email}`, text: LINKS.email, external: false },
  { key: "linkedin", href: LINKS.linkedin, text: display(LINKS.linkedin), external: true },
  { key: "github", href: LINKS.github, text: display(LINKS.github), external: true },
];
---

<section id="contact" class="block" aria-labelledby="contact-cmd">
  <Prompt id="contact-cmd" command="./contact.sh" />
  <div class="out">
    <p class="comment contact__blurb"># {CONTACT.blurb}</p>
    <dl class="contact">
      {
        items.map((l) => (
          <>
            <dt>{l.key}</dt>
            <dd>
              <a href={l.href} target={l.external ? "_blank" : undefined} rel={l.external ? "me noopener" : undefined}>
                {l.text}
                {l.external && <span class="sr-only"> (opens in a new tab)</span>}
              </a>
            </dd>
          </>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .contact__blurb {
    max-width: 72ch;
    margin-bottom: 12px;
  }

  .contact {
    display: grid;
    grid-template-columns: 9ch minmax(0, 1fr);
    column-gap: 2ch;
    row-gap: 4px;
  }

  .contact dt {
    color: var(--muted);
  }

  .contact dd {
    overflow-wrap: anywhere;
  }
</style>
