---
import { NAV, PROMPT } from "../data/site";

interface Props {
  /** true on the home page: links scroll to sections. Elsewhere they point back to the home page. */
  sectionNav?: boolean;
}

const { sectionNav = false } = Astro.props;
const prefix = sectionNav ? "" : "/";
---

<header class="titlebar" data-site-header>
  <span class="titlebar__dots" aria-hidden="true"><span></span><span></span><span></span></span>
  <a class="titlebar__title" href={sectionNav ? "#top" : "/"}>{PROMPT.user}@{PROMPT.host}: {PROMPT.path}<span class="sr-only"> (home)</span></a>
  <nav class="titlebar__nav" aria-label="Sections">
    <ul>
      {
        NAV.map((item) => (
          <li>
            <a href={`${prefix}${item.href}`} data-nav-link={item.href.slice(1)}>
              {item.label.toLowerCase()}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script src="../scripts/nav.ts"></script>

<style>
  .titlebar {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 16px;
    height: var(--bar-h);
    padding: 0 var(--pad);
    background: var(--bar);
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }

  @media (min-width: 1040px) {
    .titlebar {
      border-radius: 12px 12px 0 0;
    }
  }

  .titlebar__dots {
    flex: none;
    display: flex;
    gap: 7px;
  }

  .titlebar__dots span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .titlebar__title {
    flex: none;
    color: var(--muted);
    white-space: nowrap;
  }

  .titlebar__title:hover {
    color: var(--strong);
    text-decoration: none;
  }

  .titlebar__nav {
    margin-left: auto;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .titlebar__nav::-webkit-scrollbar {
    display: none;
  }

  .titlebar__nav ul {
    display: flex;
    gap: 4px;
  }

  .titlebar__nav a {
    display: block;
    padding: 4px 10px;
    color: var(--muted);
    white-space: nowrap;
    border-radius: 4px;
  }

  .titlebar__nav a:hover {
    color: var(--strong);
    background: var(--hover);
    text-decoration: none;
  }

  .titlebar__nav a[aria-current="true"] {
    color: var(--term);
    background: var(--green);
  }

  @media (max-width: 720px) {
    .titlebar__dots,
    .titlebar__title {
      display: none;
    }
    .titlebar__nav {
      margin-left: 0;
      margin-right: calc(var(--pad) * -1);
      padding-right: var(--pad);
    }
    .titlebar__nav ul {
      gap: 2px;
    }
  }
</style>
